# Copy this file to .env and fill in only the services you want to enable.
# Never commit .env or put these values in Vite-prefixed variables.
PORT=8787
GOOGLE_TRENDS_GEO=US

# Anthropic Console API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# YouTube Data API key: https://console.cloud.google.com/
YOUTUBE_API_KEY=

# Optional Instagram Graph API access for a connected professional account.
# General public Reels trend scraping is not supported by this API.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
